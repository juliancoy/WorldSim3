#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std430, binding = 1) readonly buffer Accum {
    uint data[];
};

layout(std430, binding = 2) readonly buffer Stats {
    uint max_density;
    uint density_cap;
};

layout(binding = 3, rgba8) uniform writeonly image2D out_image;

layout(push_constant) uniform Push {
    uint width;
    uint height;
    uint mode;
} pc;

vec4 hue_color(vec3 base, float t) {
    float cmax = max(base.r, max(base.g, base.b));
    float cmin = min(base.r, min(base.g, base.b));
    float delta = cmax - cmin;
    float h = 0.0;
    if (delta > 1e-5) {
        if (cmax == base.r) h = mod((base.g - base.b) / delta, 6.0);
        else if (cmax == base.g) h = ((base.b - base.r) / delta) + 2.0;
        else h = ((base.r - base.g) / delta) + 4.0;
        h /= 6.0;
        if (h < 0.0) h += 1.0;
    }
    float s = cmax <= 1e-5 ? 0.0 : delta / cmax;
    float sat = clamp(0.25 + 0.75 * s, 0.0, 1.0);
    float val = clamp(0.22 + 0.78 * t, 0.0, 1.0);
    float hh = h * 6.0;
    float i = floor(hh);
    float f = hh - i;
    float p = val * (1.0 - sat);
    float q = val * (1.0 - sat * f);
    float tt = val * (1.0 - sat * (1.0 - f));
    vec3 rgb;
    if (i < 1.0) rgb = vec3(val, tt, p);
    else if (i < 2.0) rgb = vec3(q, val, p);
    else if (i < 3.0) rgb = vec3(p, val, tt);
    else if (i < 4.0) rgb = vec3(p, q, val);
    else if (i < 5.0) rgb = vec3(tt, p, val);
    else rgb = vec3(val, p, q);
    if (s < 0.03) rgb = clamp(base * (0.25 + 0.75 * t), 0.0, 1.0);
    return vec4(rgb, 0.18 + 0.56 * t);
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= pc.width || y >= pc.height) return;

    uint pix = y * pc.width + x;
    uint base = pix * 7u;
    float density = float(data[base + 0u]) / 1024.0;
    float maxd = max(float(density_cap) / 1024.0, 1e-6);
    if (density <= 1e-6) {
        imageStore(out_image, ivec2(int(x), int(y)), vec4(0.0));
        return;
    }

    float t = clamp(density / maxd, 0.0, 1.0);
    float cw = float(data[base + 4u]) / 1024.0;
    float iw = cw > 0.0 ? 1.0 / cw : 0.0;
    vec3 base_color = vec3(
        clamp((float(data[base + 1u]) / (255.0 * 1024.0)) * iw, 0.0, 1.0),
        clamp((float(data[base + 2u]) / (255.0 * 1024.0)) * iw, 0.0, 1.0),
        clamp((float(data[base + 3u]) / (255.0 * 1024.0)) * iw, 0.0, 1.0));
    bool use_gradient = data[base + 5u] >= data[base + 6u];

    vec4 out_color;
    if (pc.mode == 1u) {
        out_color = hue_color(base_color, t);
    } else {
        out_color = use_gradient
            ? vec4(0.12 + 0.70 * t, 0.35 + 0.30 * t, 0.75 - 0.62 * t, 0.62 * t)
            : vec4(base_color * (0.30 + 0.70 * t), 0.58 * t);
    }
    imageStore(out_image, ivec2(int(x), int(y)), out_color);
}
